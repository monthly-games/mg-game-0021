name: game
description: "Zero Pollution: Cleaner Brigade Game"
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: ^3.10.3

dependencies:
  google_mobile_ads: ^5.2.0
  flutter:
    sdk: flutter
  flame: ^1.13.0
  flame_spine: ^0.3.0+1
  get_it: ^9.2.0
  equatable: ^2.0.5
  shared_preferences: ^2.5.4
  mg_common_game:
    path: ../libs/mg_common_game
  cupertino_icons: ^1.0.8

  firebase_core: ^2.32.0
  firebase_remote_config: ^4.4.7
  firebase_analytics: ^10.10.7
dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^3.0.0

flutter:
  uses-material-design: true
  assets:
    - assets/
    - assets/audio/sfx/
    - assets/audio/bgm/spine/characters/
